{
  "name": "oc-tokenizer",
  "version": "1.0.3",
  "description": "A faster than tiktoken tokenizer with first-class support for opencode models.",
  "homepage": "https://github.com/sekedus/oc-tokenizer?tab=readme-ov-file",
  "repository": {
    "type": "git",
    "url": "https://github.com/sekedus/oc-tokenizer.git"
  },
  "license": "MIT",
  "author": {
    "name": "sekedus"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "sdk": [
        "./dist/sdk.d.ts"
      ],
      "encoding": [
        "./dist/encoding/index.d.ts"
      ],
      "encoding/cl100k_base": [
        "./dist/encoding/cl100k_base.d.ts"
      ],
      "encoding/o200k_base": [
        "./dist/encoding/o200k_base.d.ts"
      ],
      "encoding/p50k_base": [
        "./dist/encoding/p50k_base.d.ts"
      ],
      "encoding/claude": [
        "./dist/encoding/claude.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./sdk": {
      "import": {
        "types": "./dist/sdk.d.ts",
        "default": "./dist/sdk.js"
      },
      "require": {
        "types": "./dist/sdk.d.cts",
        "default": "./dist/sdk.cjs"
      }
    },
    "./encoding": {
      "import": {
        "types": "./dist/encoding/index.d.ts",
        "default": "./dist/encoding/index.js"
      },
      "require": {
        "types": "./dist/encoding/index.d.cts",
        "default": "./dist/encoding/index.cjs"
      }
    },
    "./encoding/cl100k_base": {
      "import": {
        "types": "./dist/encoding/cl100k_base.d.ts",
        "default": "./dist/encoding/cl100k_base.js"
      },
      "require": {
        "types": "./dist/encoding/cl100k_base.d.cts",
        "default": "./dist/encoding/cl100k_base.cjs"
      }
    },
    "./encoding/o200k_base": {
      "import": {
        "types": "./dist/encoding/o200k_base.d.ts",
        "default": "./dist/encoding/o200k_base.js"
      },
      "require": {
        "types": "./dist/encoding/o200k_base.d.cts",
        "default": "./dist/encoding/o200k_base.cjs"
      }
    },
    "./encoding/p50k_base": {
      "import": {
        "types": "./dist/encoding/p50k_base.d.ts",
        "default": "./dist/encoding/p50k_base.js"
      },
      "require": {
        "types": "./dist/encoding/p50k_base.d.cts",
        "default": "./dist/encoding/p50k_base.cjs"
      }
    },
    "./encoding/claude": {
      "import": {
        "types": "./dist/encoding/claude.d.ts",
        "default": "./dist/encoding/claude.js"
      },
      "require": {
        "types": "./dist/encoding/claude.d.cts",
        "default": "./dist/encoding/claude.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "bench": "node bench/versus.ts",
    "build": "tsdown",
    "format": "prettier --cache --write \"src/**/*.{ts,tsx,json}\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "nanoid": "^6.0.1"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.58",
    "@ai-sdk/google": "^4.0.76",
    "@ai-sdk/openai": "^4.0.71",
    "@ai-sdk/openai-compatible": "^3.0.53",
    "@types/node": "^22.20.3",
    "ai": "^7.0.105",
    "base64-js": "^1.5.1",
    "gpt-tokenizer": "^4.0.0",
    "mitata": "^1.0.34",
    "prettier": "^3.9.7",
    "tiktoken": "^1.0.22",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "ai": "^7.0.105"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
